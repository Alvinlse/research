{
 "branches": [
  {
   "if": [
    "free_gpus",
    "==",
    80
   ],
   "then": {
    "ordering": "tier_sjf",
    "sizing": "adaptive"
   }
  },
  {
   "if": [
    "queue_depth",
    "<",
    5
   ],
   "then": {
    "ordering": "sjf",
    "sizing": "as_requested"
   }
  },
  {
   "if": [
    "offered_load",
    ">=",
    2
   ],
   "then": {
    "ordering": "firstfit",
    "sizing": "adaptive"
   }
  },
  {
   "if": [
    "prod_waiting",
    "==",
    0
   ],
   "then": {
    "ordering": "sjf",
    "sizing": "as_requested"
   }
  }
 ],
 "default": {
  "ordering": "tier_fcfs",
  "sizing": "adaptive"
 },
 "why": "Prioritize adaptive sizing and tiered scheduling to balance load and fairness."
}